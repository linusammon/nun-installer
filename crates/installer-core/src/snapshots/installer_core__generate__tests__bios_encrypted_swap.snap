---
source: crates/installer-core/src/generate.rs
expression: all(&out)
---
--- flake.nix
# Generated by nun-installer. Feel free to edit.
{
  description = "NixOS configuration for nun-box";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    disko = {
      url = "github:nix-community/disko";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs =
    { nixpkgs, disko, ... }:
    {
      nixosConfigurations."nun-box" = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux";
        modules = [
          disko.nixosModules.disko
          ./disko.nix
          ./hardware-configuration.nix
          ./configuration.nix
        ];
      };
    };
}

--- configuration.nix
# Generated by nun-installer. Feel free to edit.
{ ... }:
{
  networking.hostName = "nun-box";
  networking.networkmanager.enable = true;

  boot.loader.grub.enable = true;

  i18n.defaultLocale = "en_US.UTF-8";
  time.timeZone = "Europe/Berlin";

  # System-wide keyboard layout. The console follows it (useXkbConfig) and umbriel
  # reads it from systemd-localed, so there is a single place to change it.
  services.xserver.xkb = {
    layout = "us";
  };
  console.useXkbConfig = true;

  users.users."alice" = {
    isNormalUser = true;
    extraGroups = [
      "wheel"
      "networkmanager"
    ];
  };

  # The nun stack.
  programs.noctalia.enable = true;
  programs.umbriel.enable = true;
  services.displayManager.noctalia-greeter.enable = true;

  nix.settings.experimental-features = [
    "nix-command"
    "flakes"
  ];

  system.stateVersion = "26.05";
}

--- disko.nix
# Generated by nun-installer. Disk layout, managed by disko.
{
  disko.devices.disk.main = {
    type = "disk";
    device = "/dev/nvme0n1";
    content = {
      type = "gpt";
      partitions = {
        boot = {
          size = "1M";
          type = "EF02";
        };
        root = {
          size = "100%";
          content = {
            type = "luks";
            name = "cryptroot";
            passwordFile = "/tmp/nun-luks-password";
            settings.allowDiscards = true;
            content = {
              type = "btrfs";
              extraArgs = [ "-f" ];
              subvolumes = {
                "/root" = {
                  mountpoint = "/";
                  mountOptions = [ "compress=zstd" "noatime" ];
                };
                "/home" = {
                  mountpoint = "/home";
                  mountOptions = [ "compress=zstd" "noatime" ];
                };
                "/nix" = {
                  mountpoint = "/nix";
                  mountOptions = [ "compress=zstd" "noatime" ];
                };
                "/swap" = {
                  mountpoint = "/.swapvol";
                  swap.swapfile.size = "4096M";
                };
              };
            };
          };
        };
      };
    };
  };
}
