# Generated by nun-installer. Disk layout, managed by disko.
{
  disko.devices.disk.main = {
    type = "disk";
    device = {{ device | nix }};
    content = {
      type = "gpt";
      partitions = {
{% if uefi %}
        ESP = {
          size = "512M";
          type = "EF00";
          content = {
            type = "filesystem";
            format = "vfat";
            mountpoint = "/boot";
            mountOptions = [ "umask=0077" ];
          };
        };
{% else %}
        boot = {
          size = "1M";
          type = "EF02";
        };
{% endif %}
        root = {
          size = "100%";
          content = {
{% if encrypt %}
            type = "luks";
            name = "cryptroot";
            passwordFile = "/tmp/nun-luks-password";
            settings.allowDiscards = true;
            content = {
{% if btrfs %}
              type = "btrfs";
              extraArgs = [ "-f" ];
{% else %}
              type = "filesystem";
              format = "ext4";
{% endif %}
              mountpoint = "/";
            };
{% else %}
{% if btrfs %}
            type = "btrfs";
            extraArgs = [ "-f" ];
{% else %}
            type = "filesystem";
            format = "ext4";
{% endif %}
            mountpoint = "/";
{% endif %}
          };
        };
      };
    };
  };
}
