# Generated by nun-installer. Feel free to edit.
{ ... }:
{
  networking.hostName = {{ hostname | nix }};

{% if uefi %}
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
{% else %}
  boot.loader.grub.enable = true;
{% endif %}

  i18n.defaultLocale = {{ locale | nix }};
  time.timeZone = {{ timezone | nix }};

  # System-wide keyboard layout. The console follows it (useXkbConfig) and umbriel
  # reads it from systemd-localed, so there is a single place to change it.
  services.xserver.xkb = {
    layout = {{ keyboard_layout | nix }};
{% if keyboard_variant %}
    variant = {{ keyboard_variant | nix }};
{% endif %}
  };
  console.useXkbConfig = true;

  users.users.{{ user_name | nix }} = {
    isNormalUser = true;
    extraGroups = [
      "wheel"
      "networkmanager"
    ];
  };

  # The nun stack.
  programs.noctalia = {
    enable = true;
    systemd.enable = true;
    # NetworkManager, bluetooth, UPower and power-profiles-daemon.
    recommendedServices.enable = true;
  };
  programs.umbriel.enable = true;
  services.displayManager.noctalia-greeter.enable = true;

  nix.settings.experimental-features = [
    "nix-command"
    "flakes"
  ];

  system.stateVersion = {{ state_version | nix }};
}
